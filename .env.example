# Application Configuration
APP_NAME=Autonomous IT Incident Resolution
APP_ENV=development
LOG_LEVEL=INFO

# FastAPI Backend
API_HOST=0.0.0.0
API_PORT=8000
BACKEND_URL=http://localhost:8000

# Database
DATABASE_URL=sqlite:///./data/runtime/incidents.db

# Ollama Local LLM Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest
OLLAMA_TIMEOUT_SECONDS=30

# RAG / ChromaDB Configuration
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL=all-MiniLM-L6-v2
RUNBOOKS_DIR=./backend/runbooks

# Monitoring Thresholds (Configurable)
CPU_WARNING_THRESHOLD=70.0
CPU_CRITICAL_THRESHOLD=90.0
MEMORY_WARNING_THRESHOLD=75.0
MEMORY_CRITICAL_THRESHOLD=90.0
DISK_WARNING_THRESHOLD=80.0
DISK_CRITICAL_THRESHOLD=90.0

# Safety / Policy Configuration
AUTO_APPROVE_LOW_RISK=true
REQUIRE_APPROVAL_MEDIUM_RISK=true
REQUIRE_APPROVAL_HIGH_RISK=true
